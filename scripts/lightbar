#!/usr/bin/env bash
# Thin wrapper around z13ctl for the rear window lightbar on the
# ASUS ROG Flow Z13 (GZ302EA). Powered by https://github.com/dahui/z13ctl.
#
# z13ctl owns lighting control; raw HID and
# asusd D-Bus paths both proved unreliable on asusd 6.3.7 + kernel 6.19.

set -e

# Map a few legacy color names to z13ctl's vocabulary.
remap_color() {
    case "${1,,}" in
        pink) echo hotpink ;;
        rog)  echo blueviolet ;;
        *)    echo "$1" ;;
    esac
}

usage() {
    cat <<EOF
Usage:
    lightbar on [COLOR]         Static color (default: red)
    lightbar off                Turn off
    lightbar COLOR              Static color (e.g. 'lightbar blue')
    lightbar breathe COLOR      Breathe animation
    lightbar rainbow [SPEED]    Rainbow animation (slow/normal/fast)
    lightbar strobe COLOR       Strobe animation
    lightbar status             Show device + system status
    lightbar list-colors        List all named colors z13ctl knows

Colors: hex (ff0000) or names (red/blue/green/cyan/etc.)
EOF
}

case "${1:-}" in
    "" | -h | --help | help)
        usage
        ;;
    on)
        z13ctl --device lightbar apply --mode static --color "$(remap_color "${2:-red}")"
        ;;
    off)
        z13ctl --device lightbar off
        ;;
    breathe)
        [ -z "${2:-}" ] && { echo "Usage: lightbar breathe COLOR" >&2; exit 1; }
        z13ctl --device lightbar apply --mode breathe --color "$(remap_color "$2")"
        ;;
    rainbow)
        z13ctl --device lightbar apply --mode rainbow --speed "${2:-normal}"
        ;;
    strobe)
        [ -z "${2:-}" ] && { echo "Usage: lightbar strobe COLOR" >&2; exit 1; }
        z13ctl --device lightbar apply --mode strobe --color "$(remap_color "$2")"
        ;;
    status)
        z13ctl status
        ;;
    list-colors)
        z13ctl apply --list-colors
        ;;
    *)
        z13ctl --device lightbar apply --mode static --color "$(remap_color "$1")"
        ;;
esac
